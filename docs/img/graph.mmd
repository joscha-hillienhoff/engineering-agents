	supervisor(supervisor)
	analysis(analysis)
	planning(planning)
	validator(validator)
	approval(approval)
	hand_over(hand_over)
	__end__([<p>__end__</p>]):::last
	__start__ --> supervisor;
	analysis --> supervisor;
	approval --> supervisor;
	planning --> supervisor;
	supervisor -.-> __end__;
	supervisor -.-> analysis;
	supervisor -.-> approval;
	supervisor -.-> hand_over;
	supervisor -.-> planning;
	supervisor -.-> validator;
	validator --> supervisor;
	hand_over --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
